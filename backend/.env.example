# Server Configuration
PORT=3000
NODE_ENV=development

# Payment Provider API Keys (Paystack)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Payment Provider API Keys (Flutterwave)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key_here
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST-your_encryption_key_here

# SMS Provider (Termii)
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=YourApp

# SMS Provider (Twilio) - Alternative
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# KYC & BVN Verification
# NOTE: BVN verification requires approved contracts with providers like:
# - Youverify (https://youverify.co)
# - Smile Identity (https://usesmileid.com)
# - Dojah (https://dojah.io)
KYC_PROVIDER_API_KEY=your_kyc_provider_api_key_here
KYC_PROVIDER_API_URL=https://api.kycprovider.com/v1

# Crypto Exchange API (Example: Binance, Coinbase)
CRYPTO_EXCHANGE_API_KEY=your_crypto_exchange_api_key_here
CRYPTO_EXCHANGE_API_SECRET=your_crypto_exchange_api_secret_here

# Fraud Detection
FRAUD_DETECTION_THRESHOLD=0.7
MAX_DAILY_TRANSACTION_AMOUNT=5000000
MAX_TRANSACTION_VELOCITY=5

# Database (Optional - for production use)
# DATABASE_URL=mongodb://localhost:27017/crypto-fiat-app
# or
# DATABASE_URL=postgresql://user:password@localhost:5432/crypto_fiat_db

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_key_change_in_production
